{% else %}
<p class="muted">The original input files are not known: no fcs-prep provenance or sample sheet among the inputs.</p>
{% endif %}

<footer>
  Generated {{ generated_at }} by processor-cytometry-report {{ app_version }} (pandas {{ tools.pandas }}, matplotlib {{ tools.matplotlib }}).
